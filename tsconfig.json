{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "resolveJsonModule": true
  },
  "include": ["index.ts", "moq-session-do.ts", "metrics-collector.ts", "src/**/*.ts", "__tests__/**/*.ts"],
  "//": "`tools` is excluded because tools/moq-client is a NODE sidecar, not Worker code — it has its own tsconfig (tools/moq-client/tsconfig.json) with node types. Type-check it with `npm run typecheck:client`.",
  "exclude": ["node_modules", "examples", "tools"]
}
